# Copy to deploy/deploy.conf on the VPS and edit. Sourced by deploy.sh.
# deploy.conf is gitignored, so `git pull` never overwrites it.

# Public domain. Used for TLS certs, the CORS origin, and the frontend's API URL.
# Must not already be served by another site in /etc/nginx/sites-enabled/ --
# nginx keeps the first block for a name and silently ignores the rest, so
# reusing a name would take the other site offline. deploy.sh refuses to do that;
# disable the other site first.
DOMAIN=vthe.shop

# Also serve www.<domain> as a redirect to the bare domain. Set false for a subdomain.
REDIRECT_WWW=true

# Where the repo is checked out on the VPS. deploy.sh runs the app from here,
# so `git pull && sudo ./deploy/deploy.sh` is the whole redeploy.
APP_DIR=/srv/chirp

# System user that owns the code and runs the services.
APP_USER=chirp

# uvicorn listens here; nginx proxies /api/ to it. Keep it on loopback.
BIND_HOST=127.0.0.1
BIND_PORT=8000

REDIS_URL=redis://127.0.0.1:6379/0

# Outbound mail, for email confirmation and password reset. Leave SMTP_HOST unset
# and both features are simply unavailable: registration still works, the
# confirmation mail is never sent, and "forgot password" answers 202 without
# sending anything (it must answer the same for every address, or it becomes a
# way to ask whether an account exists). The failure is loud in the API log.
#
# The app refuses to print mail to the log in a production configuration, so
# reset tokens can never leak into journalctl.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=chirp@example.com
# SMTP_PASSWORD=an-app-password
# SMTP_FROM=Chirp <no-reply@example.com>
