# SQLite databases and their backups hold real user rows (incl. password
# hashes) — never commit them.
*.db
*.db.bak-*
# WAL sidecars, created by the journal_mode=WAL pragma
*.db-wal
*.db-shm

# Per-host deploy settings; git pull must never overwrite them.
deploy/deploy.conf
# Build fingerprints written by deploy.sh on the server.
.deploy/

twitter.db
dump.rdb
twitter_system.egg-info
.env
**/.env
backend/twitter.db
# Media files a moderation takedown moved out of the static mount's reach.
backend/uploads_quarantine/
backend/.pytest_cache
backend/.pycache
backend/twitter_system.egg-info
frontend/node_modules
frontend/dist
frontend/.vite
